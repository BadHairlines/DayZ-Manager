DISCORD_TOKEN=your_discord_bot_token
DATABASE_URL=postgresql://user:password@host:5432/database
LOG_LEVEL=INFO
DB_MAX_POOL_SIZE=10

# Recommended when using the full DayZ Manager website.
DAYZ_MANAGER_BASE_URL=https://dayzmanager.xyz

# Backward-compatible alternative from v2.3. DAYZ_MANAGER_BASE_URL takes priority.
# FLAG_WEB_BASE_URL=https://flags.dayzmanager.xyz

# Discord OAuth2 login for the private server-owner dashboard.
# DISCORD_CLIENT_ID can be omitted if it is the same application as DISCORD_TOKEN.
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_OAUTH_REDIRECT_URI=https://dayzmanager.xyz/auth/discord/callback
